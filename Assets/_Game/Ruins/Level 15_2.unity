--- !u!114 &476434134
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 476434131}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1548b3ee4b1d40a5958f05ba4e407302, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dialogues:
  - "\u041F\u043E \u0442\u0435\u043B\u0435\u043A\u0443 \u0438\u0434\u0435\u0442 \u0441\u0435\u0440\u0438\u0430\u043B
    \u043F\u0440\u043E \u043C\u0435\u043D\u0442\u043E\u0432, \u0428\u043E\u0443 \u041F\u0443\u0441\u0442\u044C
    \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0411\u0438\u0442\u0432\u0430 \u042D\u043A\u0441\u0442\u0440\u0430\u0441\u0435\u043D\u0441\u043E\u0432
    \u0438 \u043D\u043E\u0432\u043E\u0441\u0442\u0438."
  - "\u0412 \u043E\u0431\u0449\u0435\u043C \u043D\u0438\u0447\u0435\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0433\u043E."
  _alternativeDialogues:
  - "\u0412 \u0442\u0443\u043C\u0431\u043E\u0447\u043A\u0435 \u043B\u0435\u0436\u0430\u0442
    DVD \u0434\u0438\u0441\u043A\u0438."
  - "\u0421\u0430\u043C\u044B\u043C \u043F\u0435\u0440\u0432\u044B\u043C \u043B\u0435\u0436\u0438\u0442
    \"\u0410\u043D\u0442\u043E\u043B\u043E\u0433\u0438\u044F \u0444\u0438\u043B\u044C\u043C\u043E\u0432
    \u043F\u0440\u043E \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432\"."
  - "\u0411\u0443\u043C\u0435\u0440, \u0411\u0440\u0430\u0442, \u0411\u0440\u0430\u0442
    2, \u0423\u043B\u0438\u0446\u044B \u0440\u0430\u0437\u0431\u0438\u0442\u044B\u0445
    \u0444\u043E\u043D\u0430\u0440\u0435\u0439 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
    \u043F\u043E\u0445\u043E\u0436\u0438\u0435 \u0444\u0438\u043B\u044C\u043C\u044B..."
  _isDown: 0
